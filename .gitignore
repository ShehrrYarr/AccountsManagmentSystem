# ---------------------------------------------------------------
# Dependencies (installed by `composer install` / `npm install`)
# ---------------------------------------------------------------
/vendor
/node_modules

# ---------------------------------------------------------------
# Environment & secrets (copy .env.example to .env instead)
# ---------------------------------------------------------------
.env
.env.*
!.env.example
/auth.json
*.pem
*.key

# ---------------------------------------------------------------
# Built front-end assets (generated by `npm run dev` / `npm run production`
# from resources/assets via webpack.mix.js)
# ---------------------------------------------------------------
/public/assets
/public/fonts
/public/mix-manifest.json
/public/build
/public/hot
/public/storage

# ---------------------------------------------------------------
# Laravel runtime files
# (storage/ and bootstrap/cache/ also have their own .gitignore files;
#  uploaded cheque scans and receipts in storage/app/private are never committed)
# ---------------------------------------------------------------
/storage/*.key
/storage/pail
/database/*.sqlite*

# ---------------------------------------------------------------
# Testing & tooling caches
# ---------------------------------------------------------------
/.phpunit.cache
.phpunit.result.cache
/coverage
.php-cs-fixer.cache
.phpactor.json

# ---------------------------------------------------------------
# Logs
# ---------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------------------------------------------------------------
# Local dev environments
# ---------------------------------------------------------------
Homestead.json
Homestead.yaml
/.fleet
/.idea
/.nova
/.vscode
/.zed

# Claude Code local settings (dev-server launch config, local permissions)
/.claude

# ---------------------------------------------------------------
# OS / editor junk
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
